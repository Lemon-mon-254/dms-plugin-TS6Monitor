{
    "$schema": "https://danklinux.com/schemas/plugin.json",
    "id": "ts6status",
    "name": "TS6 Monitor",
    "description": "Monitor TeamSpeak 6 client activity via the Remote Apps API (no external daemon): mic/mute state, server/channel, members with avatars, speakers, and volume control.",
    "version": "0.4.1",
    "author": "lemonmon",
    "icon": "record_voice_over",
    "type": "widget",
    "capabilities": ["dankbar-widget", "teamspeak", "voice"],
    "component": "./TS6StatusWidget.qml",
    "settings": "./TS6StatusSettings.qml",
    "requires_dms": ">=1.4.0",
    "dependencies": ["curl"],
    "permissions": [
        "settings_read",
        "settings_write",
        "network",
        "process"
    ]
}